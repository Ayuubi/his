 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n    <title>Shaafi Hospital ID Card</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n\n    <style>\n        /* Printing optimizations */\n        @media print {\n            body { background: white; padding: 0; margin: 0; }\n            .no-print { display: none; }\n            .card-wrapper { gap: 0; padding: 0; }\n            /* This ensures the back follows the front immediately without a blank page */\n            .page-break { page-break-before: auto; margin-top: 20px; }\n        }\n\n        /* Shaafi Brand Colors */\n        .text-shaafi-blue { color: #2B3584; }\n        .bg-shaafi-blue { background-color: #2B3584; }\n        .text-shaafi-green { color: #008C44; }\n        .text-shaafi-red { color: #E11B22; }\n        .bg-shaafi-red { background-color: #E11B22; }\n    </style>\n</head>\n\n<body class=\"bg-gray-100\">\n  \n  <div class=\"card-wrapper flex flex-col items-center py-10\">\n      \n      <div class=\"relative w-[600px] h-[375px] bg-white shadow-2xl overflow-hidden flex flex-col border border-gray-200\">\n          \n          <div class=\"flex items-center px-6 h-[85px]\">\n              <div class=\"flex items-center flex-1\">\n                  <div class=\"w-14 h-14 rounded-full border-2 border-[#2B3584] flex items-center justify-center overflow-hidden bg-white mr-3\">\n                      <img src=\"/files/shaafi_logo.png\" alt=\"Logo\" class=\"w-full h-full object-contain\" onerror=\"this.style.display='none'; this.nextElementSibling.style.display='block'\">\n                      <span class=\"hidden text-[8px] font-bold text-shaafi-red\">LOGO</span>\n                  </div>\n                  <div class=\"leading-none\">\n                      <h1 class=\"text-shaafi-blue font-bold text-[22px]\">SHAAFI</h1>\n                      <h1 class=\"text-shaafi-blue font-bold text-[22px]\">HOSPITAL</h1>\n                  </div>\n              </div>\n              <div class=\"w-[2px] h-10 bg-shaafi-red mx-4\"></div>\n              <div class=\"flex-1 text-shaafi-blue font-bold text-[14px] leading-tight uppercase\">\n                  Dalba Kaarka Oo<br>Daryeel Qoyskaaga\n              </div>\n          </div>\n\n          <div class=\"bg-shaafi-blue text-white text-[32px] px-8 py-1 font-normal tracking-wide\">\n              KAARKA DARYEEL\n          </div>\n\n          <div class=\"flex justify-between px-8 flex-grow items-center\">\n              <div class=\"space-y-3\">\n                  <div class=\"text-[22px]\">\n                      <span class=\"text-shaafi-blue\">NAME:</span> \n                      <span class=\"text-shaafi-blue font-bold uppercase\">Yusuf Qaasim ALi</span>\n                  </div>\n                  <div class=\"text-[22px]\">\n                      <span class=\"text-shaafi-green font-bold\">PID:</span> \n                      <span class=\"text-shaafi-green font-bold\">22202022</span>\n                  </div>\n                  <div class=\"text-shaafi-red font-bold text-[34px] mt-1\">\n                      SH-KD-00003\n                  </div>\n              </div>\n\n              <div class=\"flex flex-col items-center\">\n                  <div class=\"w-[120px] h-[145px] border-[4px] border-shaafi-blue bg-gray-50 overflow-hidden\">\n                      <img src=\"/assets/frappe/images/default-avatar.png\" class=\"w-full h-full object-cover\">\n                  </div>\n                  <div class=\"text-shaafi-green font-bold mt-1 text-[16px]\">SN:KX0001</div>\n              </div>\n          </div>\n\n          <div class=\"bg-shaafi-red text-white text-center py-3 text-[19px]\">\n              CONTACT US: 612877778 / 3939\n          </div>\n      </div>\n\n      <div class=\"page-break my-4\"></div>\n\n      <div class=\"relative w-[600px] h-[375px] shadow-2xl overflow-hidden border border-gray-200\">\n          <img src=\"/files/WhatsApp Image 2026-02-23 at 12.17.09 PM.jpeg\" alt=\"Card Back\" class=\"w-full h-full object-fill\">\n      </div>\n\n  </div>\n\n</body>\n</html>",
