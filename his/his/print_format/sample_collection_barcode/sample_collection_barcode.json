 "html": "  <script src=\"https://cdn.jsdelivr.net/npm/jsbarcode@3.9.0/dist/JsBarcode.all.min.js\"></script>\r\n{% set printed_departments = [] %}\r\n\r\n{% if doc.lab_test %}\r\n  {% for samp in doc.lab_test %}\r\n    {% set dept = (samp.lab_department or '').strip() %}\r\n    {% if dept and dept.upper() not in printed_departments %}\r\n      {% set _ = printed_departments.append(dept.upper()) %}\r\n\r\n      <div class=\"label-page\">\r\n        <div class=\"label\">\r\n\r\n          <!-- ONE CENTER COLUMN (everything aligns to this width) -->\r\n          <div class=\"center-col\">\r\n\r\n            <div class=\"top\">\r\n              <div class=\"pname\">{{ frappe.db.get_value(\"Patient\", doc.patient, \"patient_name\") }}</div>\r\n              <div class=\"pid\">{{ doc.patient or '' }} / Lab-{{ doc.lab_ref or '' }}</div>\r\n            </div>\r\n\r\n            <div class=\"mid\">\r\n              <!--<img class=\"barcode\" src=\"/files/barcode.png\" alt=\"barcode\" />-->\r\n               <span style=\"display:none\" id=\"patient\">{{ samp.sample }}</span>\r\n        <svg style=\"display:none\" id=\"barcode{{ loop.index }}\"></svg>\r\n        <script>\r\n          document.addEventListener('DOMContentLoaded', function () {\r\n            let barcode = document.getElementById(\"barcode{{ loop.index }}\");\r\n            let input = \"{{ doc.lab_ref }}\";\r\n            JsBarcode(barcode, input, {\r\n              format: \"CODE128\", // or choose the appropriate barcode format\r\n              width: 2,           // Adjust the width as needed\r\n              height: 25,         // Adjust the height as needed\r\n              displayValue: true\r\n            });\r\n          });\r\n        </script>\r\n            </div>\r\n\r\n            <div class=\"bottom\">\r\n              <div class=\"dept\">{{ dept }} / NO: {{ doc.token_no }}</div>\r\n              <!--<div class=\"dept\">Time: -->\r\n              <!--{{ doc.collected_time }}-->\r\n              <!--{{ frappe.utils.formatdate(doc.collected_time) }}-->\r\n              <!--{{(doc.collected_time | string).split(' ')[0]}}-->\r\n              <!--</div>-->\r\n              <div class=\"dept\">Date: {{ frappe.utils.formatdate(doc.collected_time) }}</div>\r\n<div class=\"dept\">Time: {{ frappe.utils.get_datetime(doc.collected_time).strftime('%I:%M %p') }}</div>\r\n            </div>\r\n\r\n          </div>\r\n\r\n        </div>\r\n      </div>\r\n\r\n    {% endif %}\r\n  {% endfor %}\r\n{% endif %}\r\n\r\n<style>\r\n/* ===========================\r\n   MAIN SETTINGS (CHANGE HERE)\r\n   =========================== */\r\n:root{\r\n  --PAGE_W: 4in;       /* 4-inch roll printer width */\r\n  --PAGE_H: 2in;       /* label height (adjust if needed) */\r\n\r\n  --PAD_X: 2mm;\r\n  --PAD_Y: 2mm;\r\n\r\n  /* Barcode size (this defines the center column width) */\r\n  --BAR_W: 84mm;\r\n  /*--BAR_W: 64mm;*/\r\n  /*--BAR_H: 22mm;*/\r\n  --BAR_H: 15mm;\r\n\r\n  /* \u2b50 If barcode looks slightly left/right due to PNG padding,\r\n     adjust this. Positive = move right, Negative = move left.\r\n     Start with: 0mm then try 0.5mm, 1mm, -0.5mm */\r\n  --BAR_SHIFT_X: 0mm;\r\n\r\n  --FONT_MAIN: 12pt;\r\n  --FONT_SMALL: 8.5pt;\r\n}\r\n\r\nhtml, body { margin:0 !important; padding:0 !important; }\r\n\r\n@media print{\r\n  @page{\r\n    size: var(--PAGE_W) var(--PAGE_H);\r\n    margin: 0 !important;\r\n  }\r\n  .label-page{ page-break-after: always; break-after: page; }\r\n  .label-page:last-child{ page-break-after: auto; break-after: auto; }\r\n}\r\n\r\n/* page */\r\n.label-page{\r\n  width: var(--PAGE_W);\r\n  height: var(--PAGE_H);\r\n  display: flex;\r\n  align-items: center;\r\n  /*justify-content: center;*/\r\n   justify-content: flex-start;\r\n}\r\n\r\n/* label */\r\n.label{\r\n  width: calc(var(--PAGE_W) - (var(--PAD_X) * 2));\r\n  height: calc(var(--PAGE_H) - (var(--PAD_Y) * 2));\r\n  padding: var(--PAD_Y) var(--PAD_X);\r\n  box-sizing: border-box;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  /*justify-content: center;*/\r\n    justify-content: flex-start;\r\n}\r\n\r\n/* \u2705 the magic: one fixed center column */\r\n.center-col{\r\n  width: var(--BAR_W);           /* everything aligns to barcode width */\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  /*justify-content: center;*/\r\n  justify-content: flex-start;\r\n  \r\n  gap: 2mm;\r\n}\r\n\r\n/* text blocks match same column width */\r\n.top, .bottom{\r\n  width: 100%;\r\n  text-align: center;\r\n  line-height: 1.05;\r\n}\r\n\r\n.pname{\r\n  font-size: var(--FONT_MAIN);\r\n  font-weight: 800;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  /*text-wrap: wrap;*/\r\n  text-align: left;\r\n  \r\n}\r\n.pid, .dept{\r\n  font-size: var(--FONT_MAIN);\r\n  font-weight: 800;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  text-align: left;\r\n}\r\n\r\n/* barcode */\r\n.mid{\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: left;\r\n  /*justify-content: left;*/\r\n  align-items: left;\r\n  /*align-items: flex-start;*/\r\n}\r\n\r\n.barcode{\r\n  width: var(--BAR_W);\r\n  height: var(--BAR_H);\r\n  /*object-fit: contain;*/\r\n  /*display: block;*/\r\n\r\n  /* \u2705 micro-adjust if PNG has uneven internal whitespace */\r\n  /*transform: translateX(var(--BAR_SHIFT_X));*/\r\n\r\n  /* crispness */\r\n  image-rendering: crisp-edges;\r\n  image-rendering: pixelated;\r\n  /*text-align: left;*/\r\n  \r\n  /* display: flex;*/\r\n  /*justify-content: left;*/\r\n}\r\n</style>\r\n",
