 "html": "<script src=\"https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js\"></script>\r\n{% set printed_departments = [] %}\r\n\r\n{% if doc.lab_test %}\r\n  {% for samp in doc.lab_test %}\r\n    {% set dept = (samp.lab_department or '').strip() %}\r\n    {% if dept and dept.upper() not in printed_departments %}\r\n      {% set _ = printed_departments.append(dept.upper()) %}\r\n\r\n      <div class=\"label-page\">\r\n        <div class=\"label\">\r\n\r\n          <!-- ONE CENTER COLUMN (everything aligns to this width) -->\r\n          <div class=\"center-col\">\r\n\r\n            <div class=\"top\">\r\n              <div class=\"pname\">{{ doc.patient_name or '' }}</div>\r\n              <div class=\"pid\">{{ doc.patient or '' }} / Lab-{{ doc.lab_ref or '' }}</div>\r\n            </div>\r\n\r\n            <div class=\"mid\">\r\n              <!-- Use unique ID for each barcode -->\r\n              <svg class=\"barcode-svg\" id=\"barcode-{{ loop.index }}\"></svg>\r\n            </div>\r\n\r\n            <div class=\"bottom\">\r\n              <div class=\"dept\">{{ dept }} / NO: {{ doc.token_no }}</div>\r\n              <div class=\"dept\">Date: {{ frappe.utils.formatdate(doc.collected_time) }}</div>\r\n              <div class=\"dept\">Time: {{ frappe.utils.get_datetime(doc.collected_time).strftime('%I:%M %p') }}</div>\r\n            </div>\r\n\r\n          </div>\r\n\r\n        </div>\r\n      </div>\r\n\r\n    {% endif %}\r\n  {% endfor %}\r\n{% endif %}\r\n\r\n<script>\r\n// Wait for DOM to be ready\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  {% if doc.lab_test %}\r\n    {% for samp in doc.lab_test %}\r\n      {% set dept = (samp.lab_department or '').strip() %}\r\n      {% if dept and dept.upper() not in printed_departments %}\r\n        // Generate barcode with unique ID\r\n        // You can customize the barcode value - using patient ID + department as example\r\n        var barcodeValue = \"{{ doc.patient or '' }}-{{ dept|replace(' ', '')|upper }}\";\r\n        if (barcodeValue && barcodeValue.trim() !== '') {\r\n          JsBarcode(\"#barcode-{{ loop.index }}\", barcodeValue, {\r\n            format: \"CODE128\",\r\n            width: 2,\r\n            height: 60,  // Reduced height to fit better\r\n            displayValue: true,\r\n            fontSize: 12,\r\n            lineColor: \"#000\",\r\n            margin: 5,\r\n            background: \"#fff\"\r\n          });\r\n        }\r\n      {% endif %}\r\n    {% endfor %}\r\n  {% endif %}\r\n});\r\n</script>\r\n\r\n<style>\r\n/* ... keep your existing CSS ... */\r\n</style>",
