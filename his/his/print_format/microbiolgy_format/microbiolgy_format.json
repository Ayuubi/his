 "html": "<div class=\"max-w-4xl mx-auto p-8 bg-white border border-gray-200 shadow-sm font-sans text-sm text-gray-800\">\n  \n  <div class=\"text-center mb-6\">\n    <h1 class=\"text-2xl font-bold uppercase tracking-wide\">Shaafi Hospital Microorganism Test Report</h1>\n    <div class=\"h-1 bg-blue-900 w-full mt-2\"></div>\n  </div>\n\n  <div class=\"grid grid-cols-3 gap-y-3 gap-x-6 border-b pb-6 mb-6\">\n    <div><span class=\"font-bold\">Name:</span> Mohamud Ahmed</div>\n    <div><span class=\"font-bold\">Admission No:</span> P401226</div>\n    <div><span class=\"font-bold\">Sex:</span> Male</div>\n    \n    <div><span class=\"font-bold\">Specimen Source:</span> Wound Swab</div>\n    <div><span class=\"font-bold\">Age:</span> 0</div>\n    <div><span class=\"font-bold\">Department:</span> Internal medicine(1)</div>\n    \n    <div><span class=\"font-bold\">Ordering Physician:</span> Raage Abdiqadir Mash</div>\n    <div><span class=\"font-bold\">Collection Time:</span> 2025-12-30 07:58</div>\n    <div><span class=\"font-bold\">Ordering Time:</span> 2025-12-30 09:58</div>\n  </div>\n\n  <div class=\"bg-gray-50 p-4 rounded-md border mb-6\">\n    <div class=\"grid grid-cols-2\">\n      <p><span class=\"font-bold text-blue-900 uppercase\">Organism (001):</span> <span class=\"italic text-lg\">Klebsiella pneumoniae</span></p>\n      <p class=\"text-right\"><span class=\"font-bold text-red-600\">Resistance Statistics:</span> MDR (Multi-Drug Resistant)</p>\n    </div>\n  </div>\n\n  <table class=\"w-full border-collapse border border-gray-300 mb-6\">\n    <thead class=\"bg-gray-100\">\n      <tr>\n        <th class=\"border border-gray-300 px-2 py-2 text-left\">Antibiotic Name</th>\n        <th class=\"border border-gray-300 px-2 py-2 text-center\">Group</th>\n        <th class=\"border border-gray-300 px-2 py-2 text-center\">MIC (\u00b5g/mL)</th>\n        <th class=\"border border-gray-300 px-2 py-2 text-center text-red-600\">Result</th>\n        <th class=\"border border-gray-300 px-2 py-2 text-left\">Note</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr class=\"bg-green-50\">\n        <td class=\"border border-gray-300 px-2 py-1 font-medium\">Cefoxitin</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">B</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2264 8</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold\">S</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs\"></td>\n      </tr>\n      <tr>\n        <td class=\"border border-gray-300 px-2 py-1 font-medium\">Meropenem</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">B</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2264 1</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold\">S</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs\"></td>\n      </tr>\n      <tr class=\"bg-green-50\">\n        <td class=\"border border-gray-300 px-2 py-1 font-medium\">Colistin</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">O</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2264 1</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold\">S</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs text-blue-700\">98, T24</td>\n      </tr>\n      <tr>\n        <td class=\"border border-gray-300 px-2 py-1 font-medium text-red-700\">Ampicillin</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">A</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2265 32</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold text-red-600\">R</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs italic\">IR</td>\n      </tr>\n      <tr class=\"bg-red-50\">\n        <td class=\"border border-gray-300 px-2 py-1 font-medium text-red-700\">Ceftriaxone</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">B</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2265 64</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold text-red-600\">R</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs text-blue-700\">T02</td>\n      </tr>\n      <tr>\n        <td class=\"border border-gray-300 px-2 py-1 font-medium text-red-700 text-xs\">Piperacillin/Tazobactam</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">B</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center\">\u2265 128/4</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-center font-bold text-red-600\">R</td>\n        <td class=\"border border-gray-300 px-2 py-1 text-xs\"></td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"grid grid-cols-2 gap-8 text-[11px] border-t pt-4\">\n    <div>\n      <p class=\"font-bold mb-1\">Key:</p>\n      <p><span class=\"font-semibold\">S:</span> Susceptible | <span class=\"font-semibold\">I:</span> Intermediate | <span class=\"font-semibold\">R:</span> Resistant</p>\n      <p><span class=\"font-semibold\">IR:</span> Intrinsic Resistance | <span class=\"font-semibold\">MDR:</span> Multi-Drug Resistant</p>\n      <p class=\"mt-2 text-gray-500 italic uppercase\">The result is for the doctors' reference only.</p>\n    </div>\n    <div class=\"space-y-1\">\n      <p><span class=\"font-bold\">T02:</span> Cefotaxime and ceftriaxone have almost identical spectrum.</p>\n      <p><span class=\"font-bold\">T24:</span> Polymyxin B deduced from colistin results.</p>\n      <p><span class=\"font-bold\">98:</span> Criteria adapted from EUCAST breakpoint.</p>\n    </div>\n  </div>\n\n  <div class=\"mt-12 flex justify-between items-end border-t border-dotted pt-4\">\n    <div class=\"text-xs\">\n      <p><span class=\"font-bold\">Technologist:</span> Admin</p>\n      <p><span class=\"font-bold\">Test Time:</span> 2025-12-30</p>\n    </div>\n    <div class=\"text-xs text-center border-t w-48 pt-1\">\n      Reviewer Signature\n    </div>\n  </div>\n</div>",
