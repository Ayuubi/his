 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n  @page { size: A4; margin: 10mm; }\r\n  * { box-sizing: border-box; }\r\n  .pf-wrap{\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 12px;\r\n    color: #111;\r\n    -webkit-print-color-adjust: exact;\r\n    print-color-adjust: exact;\r\n  }\r\n\r\n  .pf-letterhead{ max-height: 120px; overflow: hidden; margin-bottom: 8px; }\r\n  .pf-letterhead img{ max-width: 100%; max-height: 110px; object-fit: contain; }\r\n\r\n  .pf-topbar{\r\n    width: 100%;\r\n    border: 1px solid #dcdcdc;\r\n    border-radius: 10px;\r\n    padding: 8px 10px;\r\n    background: #f7f7f7;\r\n    margin-bottom: 12px;\r\n  }\r\n  .pf-topbar table{ width: 100%; border: none; border-collapse: collapse; font-size: 12px; }\r\n  .pf-topbar td{ border: none; padding: 0; vertical-align: middle; }\r\n  .pf-pill{\r\n    display: inline-block;\r\n    padding: 3px 10px;\r\n    border-radius: 999px;\r\n    border: 1px solid #d0d0d0;\r\n    background: #fff;\r\n    font-weight: 700;\r\n    letter-spacing: .2px;\r\n  }\r\n\r\n  .pf-section-title{\r\n    margin: 12px 0 8px;\r\n    padding: 8px 10px;\r\n    border: 1px solid #dedede;\r\n    border-radius: 10px;\r\n    background: #f2f2f2;\r\n    font-weight: 800;\r\n    text-transform: uppercase;\r\n    letter-spacing: .35px;\r\n  }\r\n\r\n  .pf-card{\r\n    border: 1px solid #dedede;\r\n    border-radius: 12px;\r\n    background: #fcfcfc;\r\n    padding: 10px 12px;\r\n    margin-bottom: 12px;\r\n  }\r\n  .pf-info{ width: 100%; border-collapse: collapse; font-size: 12.5px; }\r\n  .pf-info td{ border: none; padding: 4px 6px; vertical-align: top; }\r\n  .pf-label{ color: #444; font-weight: 700; width: 18%; white-space: nowrap; }\r\n  .pf-value{ font-weight: 700; }\r\n  .pf-muted{ color: #666; font-weight: 600; }\r\n\r\n  .screening-table{\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 12px;\r\n    border: 1px solid #111;\r\n    border-radius: 10px;\r\n    overflow: hidden;\r\n  }\r\n  .screening-table th{\r\n    background: #efefef;\r\n    border: 1px solid #111;\r\n    padding: 8px;\r\n    text-align: center;\r\n    font-weight: 800;\r\n  }\r\n  .screening-table th.qcol{ text-align: left; }\r\n  .screening-table td{\r\n    border: 1px solid #111;\r\n    padding: 7px 8px;\r\n    vertical-align: middle;\r\n  }\r\n  .screening-table tbody tr:nth-child(even){ background: #fafafa; }\r\n\r\n  .check-cell{\r\n    text-align: center;\r\n    width: 12%;\r\n    font-size: 16px;\r\n    font-weight: 800;\r\n    font-family: \"DejaVu Sans\", Arial, Helvetica, sans-serif;\r\n  }\r\n  .q-text{ line-height: 1.25; }\r\n\r\n  .pf-notes{ margin-top: 12px; }\r\n  .pf-notes .row{\r\n    border: 1px solid #dedede;\r\n    border-radius: 12px;\r\n    padding: 10px 12px;\r\n    background: #fff;\r\n    margin-bottom: 10px;\r\n  }\r\n  .pf-notes .title{\r\n    font-weight: 800;\r\n    margin-bottom: 6px;\r\n    text-transform: uppercase;\r\n    letter-spacing: .2px;\r\n  }\r\n  .pf-notes .content{\r\n    min-height: 22px;\r\n    border: 1px dashed #cfcfcf;\r\n    border-radius: 10px;\r\n    padding: 8px 10px;\r\n    background: #fbfbfb;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .pf-footer{\r\n    margin-top: 14px;\r\n    font-size: 11px;\r\n    color: #666;\r\n    border-top: 1px solid #e0e0e0;\r\n    padding-top: 8px;\r\n  }\r\n</style>\r\n\r\n<div class=\"pf-wrap\">\r\n\r\n  <div class=\"pf-letterhead\">\r\n    {{ letter_head }}\r\n  </div>\r\n\r\n  <div class=\"pf-topbar\">\r\n    <table>\r\n      <tr>\r\n        <td style=\"text-align:left;\">\r\n          <span class=\"pf-pill\">Ref: {{ doc.name }}</span>\r\n        </td>\r\n        <td style=\"text-align:right;\">\r\n          {% set _date = doc.get_formatted(\"date\") or doc.get(\"date\") or frappe.utils.nowdate() %}\r\n          <span class=\"pf-pill\">Date: {{ _date }}</span>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n  </div>\r\n\r\n  {% set mobile = doc.get(\"mobile\") or doc.get(\"phone\") or \"\" %}\r\n  {% set emergency = doc.get(\"emergency_number\") or doc.get(\"emergency_contact_number\") or \"\" %}\r\n  {% set id_passport = doc.get(\"passport\") or doc.get(\"id_passport\") or \"\" %}\r\n  {% set patient_label = doc.get(\"patient_name\") or doc.get(\"patient\") or \"\" %}\r\n  {% set age = doc.get(\"age\") or \"\" %}\r\n  {% set sex = doc.get(\"sex\") or \"\" %}\r\n\r\n  <div class=\"pf-card\">\r\n    <table class=\"pf-info\">\r\n      <tr>\r\n        <td class=\"pf-label\">Patient</td>\r\n        <td class=\"pf-value\" style=\"width: 45%;\">{{ patient_label }}</td>\r\n\r\n        <td class=\"pf-label\" style=\"width: 16%;\">Age / Sex</td>\r\n        <td class=\"pf-value\" style=\"width: 21%;\">{{ age }}{% if age and sex %} / {% endif %}{{ sex }}</td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td class=\"pf-label\">ID / Passport</td>\r\n        <td class=\"pf-muted\">{{ id_passport }}</td>\r\n\r\n        <td class=\"pf-label\">Contact</td>\r\n        <td class=\"pf-muted\">\r\n          {% if mobile %}{{ mobile }}{% endif %}\r\n          {% if mobile and emergency %} / {% endif %}\r\n          {% if emergency %}{{ emergency }}{% endif %}\r\n        </td>\r\n      </tr>\r\n    </table>\r\n  </div>\r\n\r\n  <div class=\"pf-section-title\">Medical Assessment</div>\r\n\r\n  <table class=\"screening-table\">\r\n    <thead>\r\n      <tr>\r\n        <th class=\"qcol\" style=\"width: 76%;\">Medical Assessment Question</th>\r\n        <th style=\"width: 12%;\">Yes</th>\r\n        <th style=\"width: 12%;\">No</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n\r\n      {% set questions = [\r\n        (\"1. Do you suffer from epilepsy or from sudden attacks of loss of consciousness or giddiness from any cause?\", \"yes1\", \"no1\", none, none),\r\n        (\"2. Are you suffering from stroke or paralysis?\", \"yes2\", \"no2\", none, none),\r\n        (\"3. Are you suffering any mental disease or take medication?\", \"yes3\", \"no3\", none, none),\r\n        (\"4. Have you ever been diagnosed with Tuberculosis (TB)?\", \"yes5\", \"no5\", none, none),\r\n        (\"5. Hypertension (BP)\", \"yes6\", \"no6\", none, none),\r\n        (\"6. Diabetes Mellitus\", \"yes7\", \"no7\", none, none),\r\n        (\"7. COPD (Asthma / Bronchitis / Emphysema etc.)\", \"yes8\", \"no8\", none, none),\r\n\r\n        (\"8. Heart related illness\", \"yes9\", \"no9\", \"yess9\", \"noo9\"),\r\n\r\n        (\"9. Liver disease\", \"yes10\", \"no10\", none, none),\r\n        (\"10. Kidney disease\", \"yes11\", \"no11\", none, none),\r\n        (\"11. Cancer\", \"yes12\", \"no12\", none, none),\r\n        (\"12. Bleeding Disorder\", \"yes13\", \"no13\", none, none),\r\n        (\"13. Pregnant\", \"yes14\", \"no14\", none, none)\r\n      ] %}\r\n\r\n      {% for q_text, yes_field, no_field, yes_alt, no_alt in questions %}\r\n        {% set yes_val = doc.get(yes_field) or (yes_alt and doc.get(yes_alt)) %}\r\n        {% set no_val  = doc.get(no_field)  or (no_alt and doc.get(no_alt)) %}\r\n        <tr>\r\n          <td class=\"q-text\">{{ q_text }}</td>\r\n          <td class=\"check-cell\">{{ \"\u2611\" if yes_val else \"\u2610\" }}</td>\r\n          <td class=\"check-cell\">{{ \"\u2611\" if no_val else \"\u2610\" }}</td>\r\n        </tr>\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <div class=\"pf-notes\">\r\n    {% if doc.get(\"if_yes\") %}\r\n      <div class=\"row\">\r\n        <div class=\"title\">If Pregnant, how many weeks?</div>\r\n        <div class=\"content\">{{ doc.get(\"if_yes\") }}</div>\r\n      </div>\r\n    {% endif %}\r\n\r\n    {% if doc.get(\"txt\") %}\r\n      <div class=\"row\">\r\n        <div class=\"title\">Any Other (Specify)</div>\r\n        <div class=\"content\" style=\"min-height: 70px;\">{{ doc.get(\"txt\") }}</div>\r\n      </div>\r\n    {% endif %}\r\n  </div>\r\n\r\n  <div class=\"pf-footer\">\r\n    Printed on: {{ frappe.utils.now_datetime().strftime(\"%Y-%m-%d %H:%M\") }}\r\n    {% set prepared_by = frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner %}\r\n    &nbsp; | &nbsp; Prepared by: {{ prepared_by }}\r\n  </div>\r\n\r\n</div>\r\n",
