 "doctype": "Print Format",
 "font_size": 14,
 "html": "\r\n\r\n\r\n\r\n<style>\r\n\t/* Reset default browser styles for printing */\r\n\t@media print {\r\n\t\t@page {\r\n\t\t\tmargin: 0;\r\n\t\t\t/* We set this to auto so the printer driver decides the width */\r\n\t\t\tsize: auto; \r\n\t\t}\r\n\t\tbody {\r\n\t\t\tmargin: 0;\r\n\t\t\tpadding: 0;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.print-format {\r\n\t\t/* Changed from 60mm to 100% to fill the whole paper */\r\n\t\twidth: 100%; \r\n\t\tmargin: 0 auto;\r\n\t\t/*padding-left:20px;*/\r\n\t\tfont-weight: bold !important;\r\n\t\t/* Reduced padding to 0 to make the text wider */\r\n\t\tpadding: 0px 1px; \r\n\t\tfont-family: 'Courier New', Courier, monospace; \r\n\t\tfont-size: 11px; /* Slightly adjusted for better fit */\r\n\r\n\t\tline-height: 1.2;\r\n\t\tcolor: black !important;\r\n\t}\r\n\r\n\t/* Utility Classes */\r\n\t.text-center { text-align: center; }\r\n\t.text-left { text-align: left; }\r\n\t.text-right { text-align: right; }\r\n\t.bold { font-weight: bold; }\r\n\t\r\n\t/* Divider Line */\r\n\t.divider {\r\n\t\tborder-top: 1px dashed #000;\r\n\t\tmargin: 5px 0;\r\n\t\twidth: 100%;\r\n\t}\r\n\r\n\t/* Token Styling */\r\n\t.token-wrapper {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: center;\r\n\t\tmargin-bottom: 5px;\r\n\t}\r\n\t.token {\r\n\t\theight: 40px;\r\n\t\twidth: 40px;\r\n\t\tborder: 2px solid #000;\r\n\t\tborder-radius: 50%;\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t\tjustify-content: center;\r\n\t\tfont-size: 18px;\r\n\t\tfont-weight: 900;\r\n\t}\r\n\r\n\t/* Key-Value Pair Layout */\r\n\t.info-row {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\talign-items: flex-start; /* Aligns text to top if it wraps */\r\n\t\tmargin-bottom: 4px;\r\n\t}\r\n\t.label {\r\n\t\twhite-space: nowrap;\r\n\t\tpadding-right: 2px;\r\n\t\tborder:none;\r\n\t\tfont-weight: 700;\r\n\t\t/* Reduced slightly to 13px to prevent wrapping on 58mm */\r\n\t\tfont-size: 13px; \r\n\t\t\tcolor: black !important;\r\n\t}\r\n\t.value {\r\n\tfont-weight: 700 !important;\r\n\t\ttext-align: right;\r\n\t\tword-wrap: break-word; \r\n\t\tfont-size: 12px;\r\n\t\t/* Ensure value takes up remaining space */\r\n\t\tflex-grow: 1; \r\n\t\t\tcolor: black !important;\r\n\t}\r\n\r\n\t/* Headers */\r\n\th3, h4 {\r\n\t\tmargin: 2px 0;\r\n\t\tfont-weight: bold;\r\n\t\tfont-size: 12px;\r\n\t}\r\n</style>\r\n\r\n<div class=\"print-format\">\r\n\r\n\t{% if letter_head and not no_letterhead -%}\r\n\t\t<div class=\"text-center\" style=\"margin-bottom: 5px;\">\r\n\t\t\t{{ letter_head }}\r\n\t\t</div>\r\n\t{%- endif %}\r\n\r\n\t<div class=\"token-wrapper\">\r\n\t\t<div class=\"token\">{{ doc.token_no }}</div>\r\n\t</div>\r\n\r\n\t<div class=\"section\">\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">ID:</span>\r\n\t\t\t<span class=\"value\">{{ frappe.get_doc('Patient', doc.patient).name }}</span>\r\n\t\t</div>\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Name:</span>\r\n\t\t\t<span class=\"value\">{{ frappe.get_doc('Patient', doc.patient).patient_name }}</span>\r\n\t\t\r\n\t\t</div>\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Sex/Age:</span>\r\n\t\t\t<span class=\"value\">\r\n\t\t\t\t{{ frappe.db.get_value(\"Patient\", doc.patient, \"sex\") }} / \r\n\t\t\t\t{{ frappe.db.get_value(\"Patient\", doc.patient, \"p_age\") or \"\" }} \r\n\t\t\t\t{{ frappe.db.get_value(\"Patient\", doc.patient, \"age_type\") or \"\" }}\r\n\t\t\t</span>\r\n\t\t</div>\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Mobile:</span>\r\n\t\t\t<span class=\"value\">{{ frappe.get_doc('Patient', doc.patient).mobile }}</span>\r\n\t\t</div>\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Date:</span>\r\n\t\t\t<span class=\"value\">{{ doc.get_formatted(\"date\") }}</span>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<div class=\"divider\"></div>\r\n\r\n\t<div class=\"section\">\r\n\t\t{% if doc.practitioner %}\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Doctor:</span>\r\n\t\t\t<span class=\"value\">{{ doc.practitioner }}</span>\r\n\t\t</div>\r\n\t\t{% endif %}\r\n\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Type:</span>\r\n\t\t\t<span class=\"value\">Consultant</span>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"info-row\" style=\"margin-top: 5px;\">\r\n\t\t\t<span class=\"label bold\" style=\"font-size: 14px;\">Amount:</span>\r\n\t\t\t<span class=\"value bold\" style=\"font-size: 14px;\">${{ doc.paid_amount }}</span>\r\n\t\t</div>\r\n        \r\n        {% if doc.follow_up %}\r\n            <div class=\"info-row\" style=\"margin-top: 5px;\">\r\n                <span class=\"label bold\" style=\"font-size: 14px;\">Status:</span>\r\n                <span class=\"value bold\" style=\"font-size: 14px;\">Follow Up Visit</span>\r\n            </div>\r\n        {% elif doc.referring_practitioner %}\r\n                <div class=\"info-row\" style=\"margin-top: 5px;\">\r\n                    <span class=\"label bold\" style=\"font-size: 14px;\">Status:</span>\r\n                    <span class=\"value bold\" style=\"font-size: 14px;\">Referr Follow Up Visit</span>\r\n                </div>\r\n                \r\n                <div class=\"info-row\" style=\"margin-top: 5px;\">\r\n                    <span class=\"label bold\" style=\"font-size: 14px;\">Referred By:</span>\r\n                    <span class=\"value bold\" style=\"font-size: 14px;\">{{ doc.referring_practitioner }}</span>\r\n                </div>\r\n        {% endif %}\r\n\t</div>\r\n\t\r\n\t\t\t{% if doc.bill_to_insurance %}\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Insurance / Sponsor:</span>\r\n\t\t\t<span class=\"value\">{{ doc.insurance  }}</span>\r\n\t\t</div>\r\n\t\t<!--<div class=\"info-row\">-->\r\n\t\t<!--\t<span class=\"label\">Medical Department:</span>-->\r\n\t\t<!--\t<span class=\"value\">{{ doc.medical_department  }}</span>-->\r\n\t\t<!--</div>-->\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Membership No:</span>\r\n\t\t\t<span class=\"value\">{{ frappe.db.get_value(\"Patient\", doc.patient, \"membership_no\") }}</span>\r\n\t\t</div>\r\n\t\t{% endif %}\r\n\r\n\t<div class=\"divider\"></div>\r\n\r\n\t<div class=\"section\">\r\n\t\t<div class=\"info-row\">\r\n\t\t\t<span class=\"label\">Cashier:</span>\r\n\t\t\t<span class=\"value\">{{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") }}</span>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<div class=\"divider\"></div>\r\n\r\n\t<div class=\"text-center\" style=\"margin-top: 10px;\">\r\n\t\t<span class=\"bold\">-- Welcome to Shaafi Hospital --</span>\r\n\t</div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n",
