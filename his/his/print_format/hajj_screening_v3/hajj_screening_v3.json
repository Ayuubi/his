 "font_size": 14,
 "html": "\n\n\n\n<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: auto; border: 1px solid #ccc; padding: 20px;\">\n    \n    <div style=\"text-align: center; border-bottom: 2px solid #749BC2; padding-bottom: 10px; margin-bottom: 20px;\">\n        <p style=\"font-size: 20px; font-weight: bold; color: #749BC2; margin: 5px 0;\">Federal Republic of Somalia</p>\n        <p style=\"font-size: 20px; font-weight: bold; color: #749BC2; margin: 5px 0;\">Ministry of Endowments & Religious Affairs</p>\n        <p style=\"font-size: 20px; font-weight: bold; color: #749BC2; margin: 5px 0;\">SOMALI HAJJ MEDICAL MISSION 1447 / 2026</p>\n        <p style=\"font-size: 20px; font-weight: bold; color: #8DD8FF; margin: 5px 0;\">MEDICAL EXAMINATION REPORT FOR HAJJ PILGRIM</p>\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"background-color: #f2f2f2; padding: 5px; color: #333;\">A. PILGRIM IDENTIFICATION DETAILS</h3>\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 30%;\">Full Name:</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{doc.patient_name}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">Gender / Age:</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{doc.sex or \"\"}} {{doc.age or \"\"}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">Passport Number:</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{doc.passport or \"\"}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">Nationality / Phone:</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">Somalia {{doc.mobile or \"\"}}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"background-color: #f2f2f2; padding: 5px; color: #333;\">B. PHYSICAL EXAMINATION</h3>\n        {% if doc.vital_sign and doc.vital_sign|length > 0 %}\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n            <p>Height:  {{ doc.vital_sign[0].height or \"\"}} cm</p>\n            <p>Weight:  {{ doc.vital_sign[0].weight or \"\"}} kg</p>\n            <p>Blood Pressure:  {{ doc.vital_sign[0].bp or \"\"}} mmHg</p>\n            <p>Pulse Rate:  {{ doc.vital_sign[0].pr or \"\"}} bpm</p>\n            <p>Resp. Rate:  {{ doc.vital_sign[0].resps or \"\"}} /min</p>\n            <p>Temp:  {{ doc.vital_sign[0].temp or \"\"}} \u00b0C</p>\n            <p>O2 Saturation:  {{ doc.vital_sign[0].spo or \"\"}} %</p>\n            <p><strong>General Examination Findings:</strong></p>\n            <div style=\"border: 1px solid #ddd; height: 60px;\">{{ doc.vital_sign[0].general or \"\"}}</div>\n        </div>\n        {% endif %}\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"background-color: #f2f2f2; padding: 5px; color: #333;\">C. MEDICAL HISTORY</h3>\n        <p>Known Chronic Diseases / Current Medications:</p>\n        <div style=\"border: 1px solid #ddd; height: 80px; margin-bottom: 10px;\">{{doc.known_ch or \"\"}} / {{doc.current_medications or \"\"}}</div>\n        <p>History of Surgery / Hospitalization:</p>\n        <div style=\"border: 1px solid #ddd; height: 60px;\"></div>\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"background-color: #f2f2f2; padding: 5px; color: #333;\">D. LABORATORY & INVESTIGATIONS</h3>\n        <table style=\"width: 100%; border-collapse: collapse; text-align: left;\">\n            <tr style=\"background-color: #eee;\">\n                <th style=\"padding: 8px; border: 1px solid #ddd;\">TEST</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd;\">RESULT / FINDINGS</th>\n            </tr>\n            {% for i in doc.items %}\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">{{i.item_code}}</td><td style=\"padding: 8px; border: 1px solid #ddd;\"></td></tr>\n            {% endfor %}\n        </table>\n    </div>\n    \n\n    <div style=\"margin-bottom: 20px; border: 2px solid #749BC2; padding: 10px;\">\n        <h3 style=\"margin-top: 0; color: #749BC2;\">E. FITNESS FOR HAJJ</h3>\n        <p><input type=\"checkbox\"> Medically Fit to Perform Hajj</p>\n        <p><input type=\"checkbox\"> Medically Fit with Conditions (Specify): </p>\n        <p><input type=\"checkbox\"> Not Medically Fit to Perform Hajj</p>\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"background-color: #f2f2f2; padding: 5px; color: #333;\">F. MEDICAL RECOMMENDATIONS</h3>\n        <div style=\"border: 1px solid #ddd; height: 80px;\"></div>\n    </div>\n\n    <div style=\"margin-top: 40px;\">\n        <table style=\"width: 100%;\">\n            <tr>\n                <td style=\"width: 60%;\">\n                    <p><strong>Examining Doctor:</strong> </p>\n                    <p>Qualification: </p>\n                    <p>Signature: </p>\n                    <p>Date: </p>\n                </td>\n                <td style=\"text-align: center; vertical-align: middle;\">\n                    <div style=\"border: 1px solid #333; width: 120px; height: 100px; margin: auto; display: flex; align-items: center; justify-content: center;\">\n                        <span style=\"color: #ccc;\">OFFICIAL STAMP</span>\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>",
 "idx": 0,
