 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n  /* ===== Print Page ===== */\r\n  @page { size: A4; margin: 10mm; }\r\n\r\n  /* FIX: calculate widths correctly so borders/padding don't push content off-page */\r\n  *, *::before, *::after { box-sizing: border-box; }\r\n\r\n  .wrap {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 12px;\r\n    color: #111;\r\n    width: 100%;\r\n  }\r\n\r\n  /* FIX: center the printable content and keep it inside A4 margins */\r\n  .page {\r\n    width: 100%;\r\n    max-width: 190mm;        /* A4 printable width with margins */\r\n    margin: 0 auto;          /* center on page */\r\n    padding: 0 2mm;          /* small inner padding so borders don't touch edge */\r\n  }\r\n\r\n  /* If letterhead/logo affects width */\r\n  .letter-head, .letter-head * { max-width: 100%; }\r\n\r\n  /* ===== Header / Titles ===== */\r\n  .title {\r\n    text-align: center;\r\n    font-weight: 800;\r\n    font-size: 15px;\r\n    margin: 6px 0 4px;\r\n    letter-spacing: .2px;\r\n  }\r\n  .subtitle {\r\n    text-align: center;\r\n    font-weight: 800;\r\n    font-size: 12px;\r\n    margin: 0 0 10px;\r\n    text-transform: uppercase;\r\n    border: 1px solid #777;\r\n    padding: 5px 8px;\r\n    background: #f6f6f6;\r\n  }\r\n\r\n  /* ===== Patient Block ===== */\r\n  .info-card {\r\n    border: 1px solid #777;\r\n    padding: 8px 10px;\r\n    margin-top: 6px;\r\n  }\r\n  .info-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-left: auto;       /* FIX: ensure centered */\r\n    margin-right: auto;      /* FIX: ensure centered */\r\n  }\r\n  .info-table td {\r\n    padding: 3px 6px;\r\n    vertical-align: top;\r\n  }\r\n  .k { width: 35%; font-weight: 700; color: #222; }\r\n  .v { width: 65%; font-weight: 600; color: #000; }\r\n\r\n  /* ===== Sections ===== */\r\n  .section-bar {\r\n    margin-top: 10px;\r\n    border: 1px solid #777;\r\n    background: #f3f3f3;\r\n    padding: 6px 10px;\r\n    font-weight: 800;\r\n    text-transform: uppercase;\r\n    text-align: center;\r\n    letter-spacing: .3px;\r\n  }\r\n\r\n  /* ===== Result Table ===== */\r\n  .tbl {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 6px;\r\n    margin-left: auto;       /* FIX: ensure centered */\r\n    margin-right: auto;      /* FIX: ensure centered */\r\n  }\r\n  .tbl th, .tbl td {\r\n    border: 1px solid #555;  /* FIX: darker border so print is clearer */\r\n    padding: 6px 8px;\r\n    vertical-align: top;\r\n  }\r\n  .tbl th {\r\n    background: #efefef;\r\n    font-size: 11px;\r\n    text-transform: uppercase;\r\n    letter-spacing: .2px;\r\n    font-weight: 800;\r\n  }\r\n  .tbl tbody tr:nth-child(even) { background: #fafafa; }\r\n  .right { text-align: right; }\r\n  .center { text-align: center; }\r\n\r\n  /* ===== Footer ===== */\r\n  .footer {\r\n    margin-top: 18px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: 18px;\r\n  }\r\n  .sign {\r\n    flex: 1;\r\n    border-top: 1px solid #333;\r\n    padding-top: 6px;\r\n    font-weight: 700;\r\n    min-height: 44px;\r\n  }\r\n  .muted { color: #444; font-weight: 600; }\r\n\r\n  .end {\r\n    margin-top: 14px;\r\n    border: 1px solid #111;\r\n    padding: 7px 10px;\r\n    text-align: center;\r\n    font-weight: 800;\r\n    background: #f6f6f6;\r\n  }\r\n\r\n  /* Avoid ugly breaks */\r\n  .info-card, .section-bar, .tbl, .footer, .end { page-break-inside: avoid; }\r\n</style>\r\n{% if doc.docstatus == 1 %}\r\n{% set role_profile = frappe.db.get_value(\"User\", frappe.session.user, \"role_profile_name\") %}\r\n{% if role_profile in [\"lab\", \"Lab\", \"Admin\", \"Rasiin Users\", \"Lab Supervisor\", \"Doctor\"] or frappe.session.user == \"Administrator\" %}\r\n<div class=\"wrap\">\r\n  <div class=\"page\">\r\n\r\n    {# Letterhead #}\r\n    {% if letter_head and not no_letterhead -%}\r\n      <div class=\"letter-head text-center\">{{ letter_head }}</div>\r\n    {%- else -%}\r\n      {% set logo = frappe.db.get_value('Letter Head', 'logo', 'image') %}\r\n      {% if logo %}\r\n        <div class=\"text-center\"><img src=\"{{ logo }}\" style=\"max-width:100%;\"/></div>\r\n      {% endif %}\r\n    {%- endif %}\r\n\r\n    {# Patient computed once #}\r\n    {% set p = frappe.get_doc(\"Patient\", doc.patient) if doc.patient else None %}\r\n    {% set sex = p.sex if p else (doc.patient_sex or \"\") %}\r\n    {% set age = (p.p_age if p else \"\") %}\r\n    {% set age_type = (p.age_type if p else \"\") %}\r\n    {% set tel = (p.mobile_no if p else \"\") %}\r\n\r\n    {# Title line (like your screenshots) #}\r\n    <div class=\"title\">{{ doc.template or doc.lab_test_name or \"Lab Report\" }}</div>\r\n\r\n    <div class=\"info-card\">\r\n      <table class=\"info-table\">\r\n        <tr>\r\n          <td style=\"width:50%;\">\r\n            <div><span class=\"k\">Patient Name</span> : <span class=\"v\">{{ doc.patient_name or \"\" }}</span></div>\r\n            <div><span class=\"k\">Patient ID</span> : <span class=\"v\">{{ doc.patient or \"\" }}</span></div>\r\n            <div><span class=\"k\">Sex / Age</span> : <span class=\"v\">{{ sex }}{% if age %} / {{ age }} {{ age_type }}s{% endif %}</span></div>\r\n            <!--<div><span class=\"k\">Tel No</span> : <span class=\"v\">{{ tel }}</span></div>-->\r\n            <div><span class=\"k\">Doctor</span> : <span class=\"v\">{{ doc.practitioner or doc.practitioner_name or doc.referring_practitioner_name or \"\" }}</span></div>\r\n          </td>\r\n\r\n          <td style=\"width:50%;\">\r\n            <div><span class=\"k\">Lab Ref No</span> : <span class=\"v\">{{ doc.lab_ref or \"\" }}</span></div>\r\n            <div><span class=\"k\">Date Collected</span> : <span class=\"v\">{{ doc.date or \"\" }} {% if doc.time_collected %}{{ frappe.format(doc.time_collected, \"Time\") }}{% endif %}</span></div>\r\n            <div><span class=\"k\">Date Reported</span> : <span class=\"v\">{{ doc.date or \"\" }} {% if doc.time_reported %}{{ frappe.format(doc.time_reported, \"Time\") }}{% endif %}</span></div>\r\n            <div><span class=\"k\">Printed</span> : <span class=\"v\">{{ frappe.utils.now_datetime() }}</span></div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </div>\r\n\r\n    {# BODY #}\r\n    {% set groups = None %}\r\n    {% if doc.get_lab_tests_for_all %}\r\n      {% set groups = doc.get_lab_tests_for_all() %}\r\n    {% endif %}\r\n\r\n    {% if groups %}\r\n      {% for group_name, rows in groups.items() %}\r\n        <div class=\"section-bar\">{{ group_name }} Report</div>\r\n\r\n        <table class=\"tbl\">\r\n          <thead>\r\n            <tr>\r\n              <th style=\"width:45%;\">Test</th>\r\n              <th style=\"width:20%;\">Result</th>\r\n              <!--<th style=\"width:15%;\">Unit</th>-->\r\n              <th style=\"width:20%;\">Normal Range</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            {% for r in rows %}\r\n              {% if r.result_value or r.result_value == 0 %}\r\n                <tr>\r\n                  <td>{{ r.test or r.lab_test_name or \"\" }}</td>\r\n                  <td><b>{{ r.result_value }}</b></td>\r\n                  <!--<td class=\"center\">{{ r.lab_test_uom or \"\" }}</td>-->\r\n                  <td class=\"center\">{{ r.normal_range or \"\" }}</td>\r\n                </tr>\r\n              {% endif %}\r\n            {% endfor %}\r\n          </tbody>\r\n        </table>\r\n      {% endfor %}\r\n    {% else %}\r\n      <div class=\"section-bar\">{{ doc.lab_test_name or \"Lab\" }} Report</div>\r\n\r\n      <table class=\"tbl\">\r\n        <thead>\r\n          <tr>\r\n            <th style=\"width:45%;\">Test</th>\r\n            <th style=\"width:20%;\">Result</th>\r\n            <!--<th style=\"width:15%;\">Unit</th>-->\r\n            <th style=\"width:20%;\">Normal Range</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {% for r in doc.normal_test_items %}\r\n            {% if r.result_value %}\r\n              <tr>\r\n                <td>\r\n                  {% if r.lab_test_name %}<b>{{ r.lab_test_name }}</b>{% endif %}\r\n                  {% if r.lab_test_event %}<div class=\"muted\">{{ r.lab_test_event }}</div>{% endif %}\r\n                </td>\r\n                <td><b>{{ r.result_value }}</b></td>\r\n                <!--<td class=\"center\">{{ r.lab_test_uom or \"\" }}</td>-->\r\n                <td class=\"center\">{{ r.normal_range or \"\" }}</td>\r\n              </tr>\r\n            {% endif %}\r\n          {% endfor %}\r\n        </tbody>\r\n      </table>\r\n    {% endif %}\r\n\r\n    {% if doc.lab_test_comment %}\r\n      <div style=\"margin-top:10px;\">\r\n        <b>Comments:</b>\r\n        <div class=\"muted\">{{ doc.lab_test_comment }}</div>\r\n      </div>\r\n    {% endif %}\r\n\r\n    <div class=\"footer\">\r\n      <div class=\"sign\">\r\n        Reported By<br>\r\n        <span class=\"muted\">{{ frappe.get_fullname() }}</span>\r\n      </div>\r\n      <div class=\"sign\">\r\n        Authorized By<br>\r\n        <span class=\"muted\">\r\n          {{ doc.employee_name or \"\" }}\r\n          {% if doc.employee_designation %}<br>{{ doc.employee_designation }}{% endif %}\r\n        </span>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"end\">*** End of Report ***</div>\r\n\r\n  </div>\r\n</div>\r\n\r\n{% else %}\r\n  <div style=\"padding:10px; border:1px solid #999;\"><b>Not allowed to print.</b></div>\r\n{% endif %}\r\n{% else %}\r\n<div style=\"padding:10px; border:1px solid #999;\"><b>Please Submit if Results are Completed.</b></div>\r\n{% endif %}\r\n",
